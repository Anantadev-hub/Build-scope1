# BuildScope AI — frontend configuration
#
# Only public values belong here. Vite inlines every VITE_* variable into the
# browser bundle, so a VITE_ value is readable by anyone who loads the app.
# Never put a token, API key, or password in this file.
#
# Copy to `.env` (git-ignored), then restart the dev server or rebuild.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# demo        fixtures may be seeded (default for `vite dev`)
# production  no automatic fixtures (default for `vite build`)
# A signed-in demo account ("Enter demo workspace") still gets its case.
VITE_APP_MODE=

# Force fixtures on/off in either mode: on | off. Leave empty for the default.
VITE_DEMO_DATA=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# local-demo  the browser-local demo adapter (the only one implemented)
# backend     reserved for a server session adapter; this build reports a
#             configuration warning until that adapter exists.
VITE_AUTH_ADAPTER=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Absolute origin of the API, e.g. https://api.example.com
# Leave empty when the API is served from the same origin as the app.
VITE_API_BASE_URL=

# Path the repository-search route is expected to use on that origin.
VITE_REPOSITORY_SEARCH_PATH=/api/search/repositories

# Absolute URL (or path) of the repository-search route. Empty means the feature
# reports "not configured" and sends no request — it never substitutes fixtures.
# Contract: REPOSITORY_SEARCH_CONTRACT in src/services/providers.js
VITE_REPOSITORY_SEARCH_URL=
